# AI Backend: "stepfun" or "gemini"
AI_BACKEND=stepfun

# Stepfun API
STEPFUN_API_KEY=your-stepfun-api-key-here

# Google Gemini API
GENAI_API_KEY=your-google-api-key-here

# YouTube Music OAuth client
YTMUSIC_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
YTMUSIC_CLIENT_SECRET=your-google-oauth-client-secret
